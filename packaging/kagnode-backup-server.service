[Unit]
Description=KagNode dedicated backup storage worker
After=network.target

[Service]
User=kagnode-backup
Group=kagnode-backup-control
ExecStart=/usr/lib/kagnode/kagnode-backup-server serve --config /srv/kagnode/backup-server/config.json
Restart=on-failure
RestartSec=5
RuntimeDirectory=kagnode-backup
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/kagnode/backup-server /run/kagnode-backup
InaccessiblePaths=-/srv/kagnode/controller -/var/lib/kagnode-daemon

[Install]
WantedBy=multi-user.target
